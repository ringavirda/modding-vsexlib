{
  "$schema": "http://json.schemastore.org/template",
  "author": "Fallenstar",
  "classifications": ["Vintage Story", "exlib"],
  "identity": "ExpandedLib.Templates.Block",
  "name": "exlib block with a block entity",
  "shortName": "exlib-block",
  "tags": { "language": "C#", "type": "item" },
  "sourceName": "Widget",
  "preferNameDirectory": false,
  "symbols": {
    "Domain": {
      "type": "parameter", "datatype": "string", "isRequired": true,
      "replaces": "widgetdomain",
      "description": "The mod id the block is keyed under; its asset domain."
    },
    "Namespace": {
      "type": "parameter", "datatype": "string", "isRequired": true,
      "replaces": "WidgetNamespace",
      "description": "The mod project's root namespace."
    }
  }
}
