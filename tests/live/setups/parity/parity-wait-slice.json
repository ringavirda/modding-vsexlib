{
  "setup": "parity-wait-slice",
  "description": "The drain rig of parity-drain-250 with a wait until the basin holds 9 units, then the gate closed by a click: the basin's units after the close are recorded for ten seconds.",
  "mods": [
    "burdenmaker"
  ],
  "layout": {
    "legend": {
      "B": {
        "id": "bm",
        "code": "burdenmaker:burdenmaker-red-n",
        "complete": "all"
      },
      "c": {
        "cells": "bm"
      }
    },
    "layers": {
      "2": [
        "ccc",
        "..."
      ],
      "1": [
        "ccc",
        "cBc"
      ]
    },
    "origin": [
      0,
      -1
    ]
  },
  "steps": [
    {
      "insert": {
        "at": {
          "of": "bm"
        },
        "slot": 0,
        "stack": "game:crushed-iron",
        "count": 48
      }
    },
    {
      "insert": {
        "at": {
          "of": "bm"
        },
        "slot": 8,
        "stack": "game:lime",
        "count": 16
      }
    },
    {
      "interact": {
        "at": {
          "of": "bm"
        }
      }
    },
    {
      "wait": {
        "until": {
          "at": {
            "of": "bm"
          },
          "member": "BurdenUnits",
          "min": 9
        },
        "max": 10
      }
    },
    {
      "interact": {
        "at": {
          "of": "bm"
        }
      }
    }
  ],
  "seconds": 10,
  "record": {
    "machines": {
      "bm": {
        "series": {
          "state": {
            "words": [
              {
                "when": {
                  "member": "GateOpen",
                  "equals": true
                },
                "word": "open"
              },
              "shut"
            ]
          },
          "BurdenUnits": {
            "member": "BurdenUnits",
            "unit": "u"
          }
        }
      }
    }
  },
  "checks": [
    {
      "id": "basin-holds-ten",
      "says": "the basin holds 10 units after the close, as the live run does",
      "window": "steady",
      "always": { "series": "bm.BurdenUnits", "min": 10, "max": 10 }
    }
  ]
}
