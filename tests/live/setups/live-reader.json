{
  "setup": "live-reader",
  "description": "A twin-tub blower with a run of three plated pipe cells and open ends, the first beside its origin cell.",
  "mods": ["platedpipes", "twintubblower"],
  "layout": {
    "legend": {
      "B": { "id": "blower", "code": "twintubblower:blower-twintubblower-n" },
      "b": { "cells": "blower" },
      "P": {
        "run": "main",
        "code": "platedpipes:pipe-plated-straight-we",
        "family": [
          "platedpipes:pipe-plated-straight-*",
          "platedpipes:pipe-plated-bend-*",
          "platedpipes:pipe-plated-tjunction-*",
          "platedpipes:pipe-plated-xjunction-*"
        ]
      },
      "o": { "open": true }
    },
    "layers": {
      "2": ["b", "b", "b"],
      "1": ["b", "b", "BoPPPo"]
    },
    "origin": [0, -2]
  },
  "steps": [
    {
      "expect": {
        "at": { "of": "blower" },
        "block": "twintubblower:blower-twintubblower-n"
      }
    }
  ],
  "during": [
    {
      "at": 5,
      "step": {
        "set": { "at": { "of": "blower" }, "tree": { "blowerSpeed": 0.5 } }
      }
    },
    {
      "at": 12,
      "step": {
        "set": { "at": { "of": "blower" }, "tree": { "blowerSpeed": 0 } }
      }
    }
  ],
  "seconds": 20,
  "record": {
    "runs": { "main": {} },
    "machines": {
      "blower": {
        "series": {
          "state": {
            "words": [
              {
                "when": { "tree": "blowerSpeed", "min": 0.01 },
                "word": "turning"
              },
              "idle"
            ]
          },
          "speed": { "tree": "blowerSpeed", "unit": "rad/s" }
        }
      }
    }
  }
}
